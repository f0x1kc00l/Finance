<?xml version="1.0" encoding="utf-8"?>
<!-- The app makes no network requests of its own; this pins secure defaults for any library. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
