<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules: ALL app data is excluded.
  - Financial data must not leave the device through cloud backup.
  - The PIN hash and biometric key are bound to this device's Keystore; a restored copy could
    never be verified and would lock the user out.
  (android:allowBackup="false" covers Android 11 and below.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
